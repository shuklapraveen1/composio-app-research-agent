# Copy to .env and edit. Every variable is optional: the project imports,
# validates its configuration, and runs the whole pipeline with none of them set.
# All variables use the COMPOSIO_OPS_ prefix.

# --- Runtime ---------------------------------------------------------------
# local | ci
COMPOSIO_OPS_ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR | CRITICAL
COMPOSIO_OPS_LOG_LEVEL=INFO
# console | json
COMPOSIO_OPS_LOG_FORMAT=console
# Fixed run identifier. Leave unset to generate one per invocation; set it to
# make a run's log stream byte-reproducible.
# COMPOSIO_OPS_RUN_ID=

# --- Determinism -----------------------------------------------------------
# Master seed. Every stage derives its own seed from this value plus a stage
# namespace, so changing it reshuffles all sampling reproducibly.
COMPOSIO_OPS_SEED=20260916
# The pipeline clock. Stamped on every artifact instead of the wall clock, so a
# re-run next year produces byte-identical files.
COMPOSIO_OPS_AS_OF=2026-09-16T00:00:00+00:00

# --- Paths (relative paths resolve against the project root) ---------------
COMPOSIO_OPS_DATA_DIR=data
COMPOSIO_OPS_SITE_DIR=site

# --- Pipeline sizing -------------------------------------------------------
# Shape the registry loader insists on. It fails loudly rather than truncating
# or padding when the supplied list does not match.
COMPOSIO_OPS_EXPECTED_APP_COUNT=100
COMPOSIO_OPS_EXPECTED_CATEGORY_COUNT=10
# Sizes of the two verification samples. Sample B is drawn disjoint from A.
COMPOSIO_OPS_SAMPLE_SIZE_A=15
COMPOSIO_OPS_SAMPLE_SIZE_B=15

# --- Research provider -----------------------------------------------------
# corpus  - read the reviewed, committed source corpus (default; reproducible)
# composio | direct - live research; require credentials below
COMPOSIO_OPS_RESEARCH_PROVIDER=corpus

# --- Research / verification transport (live providers only) ---------------
COMPOSIO_OPS_REQUEST_TIMEOUT_SECONDS=60
COMPOSIO_OPS_MAX_CONCURRENCY=4
COMPOSIO_OPS_MAX_RETRIES=3
# COMPOSIO_OPS_RESEARCH_MODEL=
# COMPOSIO_OPS_VERIFICATION_MODEL=
# COMPOSIO_OPS_RESEARCH_API_KEY=
# COMPOSIO_OPS_RESEARCH_API_BASE_URL=

# --- Safety ----------------------------------------------------------------
# When true, stages that would make outbound calls plan only and write nothing.
COMPOSIO_OPS_DRY_RUN=false
